# Copy to .env and fill in.

# Port the web app listens on
PORT=6091

# Login for the web page (user name is "admin" unless you set APP_USER)
APP_PASSWORD=change-me

# Claude sign-in for the review step, using your Claude subscription (no API key needed).
# On the server run:  claude setup-token
# then paste the token it prints here. Keep this file private.
CLAUDE_CODE_OAUTH_TOKEN=

# Your Plex library folders ON THE SERVER
MOVIES_PATH=/srv/plex/Movies
TV_PATH=/srv/plex/TV Shows

# Run as the same user that owns the media files (run `id` on the server to see yours)
PUID=1000
PGID=1000

[Unit]
Description=Job Scraper Web App
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/flexbox-hero-layout/job_scraper_app
Environment=PORT=8420
ExecStart=/home/pi/flexbox-hero-layout/job_scraper_app/venv/bin/python app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

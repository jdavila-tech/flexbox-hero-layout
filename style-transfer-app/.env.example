# Port the app listens on
PORT=4000

# Serve over HTTPS (needed for the live camera on phones). A self-signed
# certificate is created automatically; or point to your own:
HTTPS=true
# HTTPS_CERT=/path/to/cert.pem
# HTTPS_KEY=/path/to/key.pem

# Required: reads the inspiration image's style (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Image generator: "gemini" (recommended) or "openai". Auto-picked from whichever key is set.
IMAGE_PROVIDER=gemini
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: require this code before anyone can use the app (protects your API credits
# if the app is reachable from the internet)
# ACCESS_CODE=
